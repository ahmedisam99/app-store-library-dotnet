  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "This property is a part of the `advancedCommerceInfo`. For more information on the Advanced Commerce API (ACA), see `AdvancedCommerceAPI`.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/advancedCommerceInfo",
            "doc://com.apple.documentation/documentation/AdvancedCommerceAPI"
          ]
        },
        {
          "text": "See `sending-advanced-commerce-api-requests-from-your-app` for how to construct this object. Pass the Base64-encoded advancedCommerceRequestData object as a UTF-8 string as `advancedCommerceData`. Use `SubscriptionModifyInAppRequest` with a single `SubscriptionModifyChangeItem` provided when constructing the advancedCommerceRequestData.",
          "refs": [
            "doc://com.apple.documentation/documentation/StoreKit/sending-advanced-commerce-api-requests-from-your-app",
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/advancedCommerceData",
            "doc://com.apple.documentation/documentation/AdvancedCommerceAPI/SubscriptionModifyInAppRequest",
            "doc://com.apple.documentation/documentation/AdvancedCommerceAPI/SubscriptionModifyChangeItem"
          ]
        },
        {
          "text": "For more information on the structure of JWS objects, see `generating-jws-to-sign-app-store-requests`.",
          "refs": [
            "doc://com.apple.documentation/documentation/StoreKit/generating-jws-to-sign-app-store-requests"
          ]
        }
