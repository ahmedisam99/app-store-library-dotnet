      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use `BulletPoint` items when you set up a text-based message that contains bullet points. Each bullet point item consists of the following elements:",
          "refs": []
        },
        {
          "text": "Provide an array of `BulletPoint` objects in the `UploadMessageRequestBody`  when you call `Upload-Message`.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/UploadMessageRequestBody",
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/Upload-Message"
          ]
        }
      ],
      "listItems": [
        {
          "text": "An image to use as the bullet point. To use an image as a bullet point icon, upload the image with an `imageSize` of `BULLET_POINT`. For more information, see `Upload-Image`.",
          "refs": [
