  "tables": [],
  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Call this endpoint to delete an image. After successfully deleting the image, its `imageIdentifier` no longer exists. Don’t use the `imageIdentifier` of a deleted image in any new messages.",
          "refs": []
        },
        {
          "text": "> **Note**\n>\n> When you include an image in a message, you need to delete the message before you can delete the image.",
          "refs": []
        },
        {
          "text": "This endpoint isn’t idempotent. If the system doesn’t find the image, this endpoint throws an error.",
          "refs": []
        }
      ],
