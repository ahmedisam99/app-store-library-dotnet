  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Call this endpoint to retrieve the results from a performance test you initiate by calling `Initiate-Performance-Test`.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/Initiate-Performance-Test"
          ]
        },
        {
          "text": "The API returns a JSON object that contains `PerformanceTestConfig`, `PerformanceTestResponse` , and `Failures` objects that enumerate the parameters the system used to evaluate the server performance, results of the specified test, and information that describes the failures, if any, that the test encountered.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/PerformanceTestConfig",
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/PerformanceTestResponse",
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/Failures"
