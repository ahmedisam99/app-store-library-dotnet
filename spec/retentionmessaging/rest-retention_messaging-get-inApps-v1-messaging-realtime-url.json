  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "This endpoint returns your `Get Retention Message` endpoint’s URL. The URL it provides is specific to the environment (sandbox or production) you use to call `Get-Realtime-URL`.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/Get-Realtime-URL"
          ]
        },
        {
          "text": "This endpoint returns an `HTTP 404` error with `RealtimeUrlNotFoundError` if the URL isn’t configured.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/RealtimeUrlNotFoundError"
          ]
        },
        {
          "text": "For more information on configuring your `Get Retention Message` endpoint, see `setting-up-retention-messaging-endpoint`.",
          "refs": [
