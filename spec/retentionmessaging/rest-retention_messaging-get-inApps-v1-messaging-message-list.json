  "tables": [],
  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Call this endpoint to get a list of all uploaded message identifiers and check their current state, `messageState`.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/messageState"
          ]
        },
        {
          "text": "> **Note**\n>\n> If a message includes an image, also check the image state by calling `Get-Image-List`. The system displays retention messages with images only if both the message and the image are in an `APPROVED` state.",
          "refs": [
            "doc://com.apple.retentionmessaging/documentation/RetentionMessaging/Get-Image-List"
          ]
        }
