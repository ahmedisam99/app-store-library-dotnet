      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Call this endpoint to delete a default message configuration. After a successful deletion, `productId` in `locale` has no default message.",
          "refs": []
        },
        {
          "text": "This endpoint is idempotent. If the product has no configured default message for the locale, the endpoint still responds with a `200` status code.",
