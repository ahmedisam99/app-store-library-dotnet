  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 1.2 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The new `apps` resource and the `app-metadata` collection of resources enable automating the creation of new app versions and managing App Store information.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/apps",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-metadata"
          ]
        },
        {
          "text": "The new `app-store-version-phased-releases` resource enables automating the submission of new versions of your app to the App Store.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-store-version-phased-releases"
          ]
        },
        {
          "text": "The `power-and-performance-metrics-and-logs` now enables downloading of aggregate metrics and diagnostics for App Store versions of your app.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/power-and-performance-metrics-and-logs"
          ]
        },
        {
          "text": "The `certificates` resource now supports unified software signing and multiplatform app IDs, and the `CapabilityType` has additional bundle ID capabilities.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/certificates",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/CapabilityType"
          ]
        }
      ]
    }
  ],
