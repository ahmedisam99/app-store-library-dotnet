  "introducedAt": null,
  "deprecated": null,
  "beta": false,
  "abstract": {
    "text": "Update your server-side code to use new features, and test your code against API changes.",
    "refs": []
  },
  "declaration": null,
  "constraints": [],
  "values": null,
  "properties": null,
  "endpoints": null,
  "parameters": null,
  "requestBody": null,
