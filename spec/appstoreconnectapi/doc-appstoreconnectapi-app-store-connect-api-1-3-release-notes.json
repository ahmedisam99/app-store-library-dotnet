  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 1.3 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `app-infos` resource adds an `age-ratings` relationship.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-infos",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/age-ratings"
          ]
        },
        {
          "text": "The `Attributes-data.dictionary` now separates the `gamblingAndContests` entry into two entries: `contests` and `gambling.`",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/AgeRatingDeclaration/Attributes-data.dictionary"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `GET-v1-appStoreVersions-{id}-ageRatingDeclaration` endpoint is now deprecated.",
          "refs": []
        },
        {
          "text": "The `ageRatingDeclaration` field within the `GET-v1-apps-_id_-appStoreVersions` endpoint is now deprecated.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-appStoreVersions"
          ]
        },
        {
          "text": "The `gamblingAndContests` entry of `Attributes-data.dictionary` is now deprecated.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/AgeRatingDeclaration/Attributes-data.dictionary"
          ]
        }
      ]
    }
  ],
