  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "A `buildBundles` resource represents metadata for binaries you upload to App Store Connect as a build. It provides detailed information like capabilities an app uses, supported CPU architectures, and more. For a full list of available attributes, see `Attributes-data.dictionary`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/BuildBundle/Attributes-data.dictionary"
          ]
        },
        {
          "text": "When you upload a build that contains an App Clip, use the APIs provided by the `buildBundles` resource to read:",
          "refs": []
        }
      ],
      "listItems": [
        {
          "text": "Cache status information for domains you associated with your App Clip",
          "refs": []
        },
        {
          "text": "Debug status information for domains you associated with your App Clip",
          "refs": []
        },
        {
          "text": "App Clip invocations you configured for testers who use the TestFlight app to launch your App Clip",
          "refs": []
        },
        {
          "text": "File size information for a build bundle",
          "refs": []
        }
      ]
    }
  ],
