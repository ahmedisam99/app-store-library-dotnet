  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Game Center details is the top-level endpoint for Game Center information for your apps. Use this resource to:",
          "refs": []
        },
        {
          "text": "To enable Game Center, begin by calling `POST-v1-gameCenterDetails`. Then you can create and configure achievements, leaderboards, leaderboard sets, and more.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/POST-v1-gameCenterDetails"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Enable Game Center for an app.",
          "refs": []
        },
        {
          "text": "Read information about specific types of Game Center data, including achievements, leaderboards, and localizations.",
          "refs": []
        }
      ]
    }
