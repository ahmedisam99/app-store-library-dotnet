      "name": "INACTIVE",
      "abstract": {
        "text": "The phased release hasn’t started.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    },
    {
      "name": "ACTIVE",
      "abstract": {
        "text": "The app version is released. During a phased release, the App Store releases the update over a 7-day period to a percentage of your users, randomly selected. The phased release applies to macOS and iOS devices with automatic updates enabled. Users can also manually download the app version.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    },
    {
      "name": "PAUSED",
      "abstract": {
        "text": "The App Store paused the phased release, at your request.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    },
    {
      "name": "COMPLETE",
      "abstract": {
        "text": "The process released the update to all devices that have automatic updates enabled. The phased-release process is complete.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    }
