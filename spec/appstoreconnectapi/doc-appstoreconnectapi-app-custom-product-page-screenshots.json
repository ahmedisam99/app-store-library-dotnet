      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "An `appScreenshots` resource represents a single app screenshot for an app locale and display target. Use this resource to:",
          "refs": []
        },
        {
          "text": "To upload screenshots, begin by using the `POST-v1-appScreenshotSets` endpoint for the locale and display target. To upload screenshots, you must create an asset reservation, then follow the upload operations specified in the response.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/POST-v1-appScreenshotSets"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Upload new app screenshots to App Store Connect.",
          "refs": []
        },
        {
          "text": "Download existing screenshots.",
          "refs": []
        }
      ]
    }
