  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 1.8 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The app price point information is now updated to `AppPricePointV2` to reflect the effect of the tax category settings on proceeds.",
          "refs": []
        },
        {
          "text": "The `GET-v1-salesReports` endpoint supports a new `reportType` value of `SUBSCRIPTION_OFFER_CODE_REDEMPTION`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-salesReports"
          ]
        },
        {
          "text": "TestFlight now offers a new relationship, `BetaGroups-data.dictionary`, that identifies all beta groups for a specific build.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/Build/Relationships-data.dictionary/BetaGroups-data.dictionary"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The endpoints and objects listed in `App Price Reference Data` that used the `appPricePoints` resource are now deprecated, including: `List All Price Points for an App Price Tier`, `Read the Territory Information of an App Price Point`, `Read App Price Point Information`, `List App Price Points`, `AppPricePoint`, `AppPricePointResponse`, and `AppPricePointsResponse`.",
          "refs": []
        }
      ]
    }
  ],
