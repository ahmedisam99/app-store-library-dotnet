  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App developers can get alternative distribution package IDs through the App Store Connect API by using `GET-v1-appStoreVersions-_id_-alternativeDistributionPackage`. You can also get the IDs in App Store Connect, to learn more, see `https://developer.apple.com/help/app-store-connect/distributing-apps-in-the-european-union/get-an-alternative-distribution-package-id`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-appStoreVersions-_id_-alternativeDistributionPackage",
            "https://developer.apple.com/help/app-store-connect/distributing-apps-in-the-european-union/get-an-alternative-distribution-package-id"
          ]
        },
        {
          "text": "The alternative distribution package ID is valid for distributing a marketplace app, an app on an alternative marketplace, or through web distribution. To learn more about creating alternative distribution packages, see `creating-alternative-distribution-packages`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/creating-alternative-distribution-packages"
          ]
        },
        {
          "text": "To learn more about ingesting alternative distribution packages as a marketplace, see `processing-alternative-marketplace-notifications`.",
          "refs": [
            "doc://com.apple.documentation/documentation/marketplacekit/processing-alternative-marketplace-notifications"
          ]
        }
      ],
      "listItems": []
    }
  ],
