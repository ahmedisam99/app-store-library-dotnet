  "tables": [],
  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "`ageRatingDeclarations` handles your answers to the app-characteristic questions that affect your app’s age rating. This resource enables you to answer the questions and update your answers. You must fill out this information before submitting your app for review.",
          "refs": []
        },
        {
          "text": "`territoryAgeRatings` allows you to read the age ratings per territory that are calculated by your age rating declaration responses.",
          "refs": []
        },
        {
          "text": "For more information about age ratings, see `https://developer.apple.com/help/app-store-connect/manage-app-information/set-an-app-age-rating`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/manage-app-information/set-an-app-age-rating"
          ]
        },
        {
          "text": "> **Important**\n>\n> The age-rating declaration attributes `INFREQUENT_OR_MILD` and `FREQUENT_OR_INTENSE` are deprecated. Instead, use `INFREQUENT` or `FREQUENT`.",
          "refs": []
        }
      ],
      "listItems": []
    }
  ],
