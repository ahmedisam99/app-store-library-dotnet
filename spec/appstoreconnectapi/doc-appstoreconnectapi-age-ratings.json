      "style": "important",
      "prose": {
        "text": "The age-rating declaration attributes `INFREQUENT_OR_MILD` and `FREQUENT_OR_INTENSE` are deprecated. Instead, use `INFREQUENT` or `FREQUENT`.",
        "refs": []
      }
    }
