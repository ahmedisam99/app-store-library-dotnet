  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use the APIs in this collection to help facilitate the distribution of your apps to users in the EU on an alternative app marketplace or from your website. To learn more, see `https://developer.apple.com/support/dma-and-apps-in-the-eu/`.",
          "refs": [
            "https://developer.apple.com/support/dma-and-apps-in-the-eu/"
          ]
        },
        {
          "text": "You can set up and configure your apps for alternative distribution and configure interactions with Apple Services. Use this API to manage:",
          "refs": []
        },
        {
          "text": "To learn more, see `configuring-alternative-marketplaces-and-alternative-marketplace-apps` and `configuring-apps-for-web-distribution`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/configuring-alternative-marketplaces-and-alternative-marketplace-apps",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/configuring-apps-for-web-distribution"
          ]
        }
