  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 3.1 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New Features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "Tester Metrics and Metadata now help developers identify relevant, engaged, and active testers within the tester panel to improve beta-app quality. Developers can now read session count, crash count, and feedback count for each tester. For more information see `GET-v1-apps-_id_-metrics-betaTesterUsages`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-metrics-betaTesterUsages"
          ]
        },
        {
          "text": "Game Center matchmaking rules help create better matches between players in multiplayer games using game-specific rules. You can configure your rules and test them with sample match requests and player properties. For more information, see `rules` and `testing`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/rules",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/testing"
          ]
        },
        {
          "text": "Game Center matchmaking metrics diagnose performance and other issues with matchmaking. You can get match requests, queue information, results, errors, and more. For more information, see `metrics`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/metrics"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `GET-v1-appPreOrders-{id}` endpoint is now deprecated and replaced with `GET-v2-appAvailabilities-_id_`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v2-appAvailabilities-_id_"
          ]
        },
        {
          "text": "The `POST-v1-appPreOrders` endpoint is now deprecated and replaced with `POST-v2-appAvailabilities`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/POST-v2-appAvailabilities"
          ]
        },
        {
          "text": "The `GET-v1-appAvailabilities-{id}-availableTerritories` endpoint is now deprecated and replaced with `GET-v2-appAvailabilities-_id_-territoryAvailabilities`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v2-appAvailabilities-_id_-territoryAvailabilities"
          ]
        }
      ]
    }
  ],
