      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "An achievement is a distinction that a player earns for reaching a milestone, or performing an action, defined by you and programmed into your app. After an achievement has gone live for any version of your app, it can’t be removed.",
          "refs": []
        },
        {
          "text": "For more information about how to use achievements in your app, see `https://developer.apple.com/help/app-store-connect/configure-game-center/manage-achievements`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/configure-game-center/manage-achievements"
          ]
        }
