  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `ciBuildActions` resource represents the actions Xcode Cloud performed when it built your project or workspace. Use it to read information about the actions Xcode Cloud performed during a build; for example:",
          "refs": []
        },
        {
          "text": "To update a workflow’s actions, use the `workflows` resource.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/workflows"
          ]
        },
        {
          "text": "> **Note**\n>\n>  This resource supports JSON web tokens with a lifetime of up to six months. For more information, see `generating-tokens-for-api-requests#Determine-the-Appropriate-Token-Lifetime`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/generating-tokens-for-api-requests#Determine-the-Appropriate-Token-Lifetime"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Type, name, and date information of the action",
          "refs": []
        },
        {
          "text": "Status information for an ongoing and completed action",
          "refs": []
        },
        {
          "text": "Artifacts created by the action",
          "refs": []
