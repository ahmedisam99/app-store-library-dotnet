      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use `appStoreReviewDetails` to provide information required for App Review. This information isn’t displayed on the App Store. Required attributes for App Review are:",
          "refs": []
        },
        {
          "text": "Optionally, provide notes for the review team using the notes attribute. If you need to attach a file for App Review, use the `app-store-review-attachments` resource.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-store-review-attachments"
          ]
        },
        {
          "text": "For more information see `https://developer.apple.com/help/app-store-connect/reference/app-review-information`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/reference/app-review-information"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Contact first and last name",
          "refs": []
        },
        {
          "text": "Contact phone number",
          "refs": []
        },
        {
          "text": "Contact email address",
          "refs": []
        },
        {
          "text": "Whether testing your app requires a demo account",
          "refs": []
        },
        {
          "text": "Demo account name (if your app uses a single sign-on service)",
          "refs": []
        },
        {
          "text": "Demo account password (if your app uses a single sign-on service)",
