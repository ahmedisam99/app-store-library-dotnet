      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use leaderboards in your games so players can compare their scores against other players in the same game. When you configure leaderboards in App Store Connect, you specify details such as the scores to collect and how to order them.",
          "refs": []
        },
        {
          "text": "For more information about how to use leaderboards in your app, see `https://developer.apple.com/help/app-store-connect/configure-game-center/configure-leaderboards/`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/configure-game-center/configure-leaderboards/"
          ]
        }
      ],
