  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `appStoreVersions` resource represents the information related to an App Store version of your app. Using this resource, you can:",
          "refs": []
        },
        {
          "text": "For more information about versions, see `https://developer.apple.com/help/app-store-connect/update-your-app/create-a-new-version`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/update-your-app/create-a-new-version"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Create, modify, or delete a version for your app.",
          "refs": []
        },
        {
          "text": "Read key details for your version, including its App Store state.",
          "refs": []
        },
        {
          "text": "Specify whether to release the version manually or automatically.",
          "refs": []
        },
        {
          "text": "Modify attributes such as your app’s copyright information.",
          "refs": []
        }
      ]
    }
  ],
