  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `betaAppClipInvocationLocalizations` resource represents the localization information of an App Clip you distribute to testers that’s specific to a locale. Use this resource to set the text that appears in the App Clips section of a build in the TestFlight app.",
          "refs": []
        },
        {
          "text": "For more information on testing App Clip invocations, see `testing-the-launch-experience-of-your-app-clip`.",
          "refs": [
            "doc://com.apple.documentation/documentation/AppClip/testing-the-launch-experience-of-your-app-clip"
          ]
        }
      ],
