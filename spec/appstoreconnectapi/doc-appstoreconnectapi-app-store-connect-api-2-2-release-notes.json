  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 2.2 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "Added support for getting information about and editing `sandbox-testers` and clearing `sandbox-testers` purchase history.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/sandbox-testers"
          ]
        },
        {
          "text": "Expanded support around `app-encryption-declarations`, state and documents.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-encryption-declarations"
          ]
        },
        {
          "text": "`billing-grace-periods` now has additional parameters including 3 distinct durations.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/billing-grace-periods"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `GET-v1-apps-_id_-inAppPurchases` endpoint is now deprecated and replaced with the `GET-v1-apps-_id_-inAppPurchasesV2` endpoint.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-inAppPurchases",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-inAppPurchasesV2"
          ]
        }
      ]
    }
  ],
