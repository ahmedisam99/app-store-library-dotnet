  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `certificates` resource represents the digital certificates you use to sign your iOS or Mac apps for development and distribution. You can create new certificates, revoke existing certificates, and download certificates.",
          "refs": []
        },
        {
          "text": "> **Note**\n>\n>  You can only create Developer ID certificates for macOS through the Apple Developer website or Xcode. For more information, see `https://developer.apple.com/developer-id/`.",
          "refs": [
            "https://developer.apple.com/developer-id/"
          ]
        }
      ],
