      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 2.1 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `ScreenshotDisplayType` and `PreviewType` objects add values that enable you to submit screenshots and app previews for iPhone 14, iPhone 14 Plus, iPhone 14 Pro, iPhone 14 Pro Max, Apple Watch Series 8, and Apple Watch Ultra.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/ScreenshotDisplayType",
