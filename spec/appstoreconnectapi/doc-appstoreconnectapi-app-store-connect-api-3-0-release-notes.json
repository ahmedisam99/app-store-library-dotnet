  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 3.0 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New Features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "Set up and manage all your Game Center features, like Achievements and Leaderboards. To review the full set of Game Center features, see `game-center`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/game-center"
          ]
        },
        {
          "text": "Configure specific regions where you’d like to offer your app for pre-order and set different release dates for each region. For more information on settings for pre-order, see `app-availability`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-availability"
          ]
        },
        {
          "text": "Use new endpoints for managing Export Compliance with `GET-v1-apps-_id_-appEncryptionDeclarations` and now `PATCH-v1-builds-_id_` allows you to include `appEncryptionDeclarations` in the payload.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-appEncryptionDeclarations",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/PATCH-v1-builds-_id_"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `V1` enum for type `SubscriptionStatusUrlVersion` is now deprecated and replaced with `V2`. For more information see `App-Store-Server-Notifications-V2`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/SubscriptionStatusUrlVersion",
            "doc://com.apple.documentation/documentation/AppStoreServerNotifications/App-Store-Server-Notifications-V2"
          ]
        }
      ]
    }
  ],
