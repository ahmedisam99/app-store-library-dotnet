  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `customerReviewResponses` resource represents your responses to customer reviews for apps you publish on the App Store. Each customer review can have at most one review response.",
          "refs": []
        },
        {
          "text": "Use this API to get, create, update, and delete your responses to customer reviews for your app. First, get a list of customer reviews, including their resource IDs, by calling the `GET-v1-apps-_id_-customerReviews` or `GET-v1-appStoreVersions-_id_-customerReviews` endpoints. Next use this API as follows:",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-customerReviews",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-appStoreVersions-_id_-customerReviews"
          ]
        },
        {
          "text": "For more information about reviews, see `https://developer.apple.com/app-store/ratings-and-reviews/`.",
          "refs": [
            "https://developer.apple.com/app-store/ratings-and-reviews/"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Respond to a customer review by calling `POST-v1-customerReviewResponses` using the review’s resource ID. Update your existing review using the same endpoint.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/POST-v1-customerReviewResponses"
          ]
        },
        {
          "text": "Get your existing review response by calling `GET-v1-customerReviews-_id_-response`, using the resource ID of the customer review.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-customerReviews-_id_-response"
          ]
        },
        {
          "text": "Delete your response to a customer review by calling `DELETE-v1-customerReviewResponses-_id_`, using the resource ID of your response.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/DELETE-v1-customerReviewResponses-_id_"
          ]
        }
      ]
    }
  ],
