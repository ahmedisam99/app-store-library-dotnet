  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Apple Pay developers and merchants can use this resource to automate registering both merchant ID and merchant name for interacting with Apple Pay services, and rotate required certificates to keep the service active. To learn more about developing and configuring Apple Pay, see `https://developer.apple.com/help/account/configure-app-capabilities/configure-apple-pay/`.",
          "refs": [
            "https://developer.apple.com/help/account/configure-app-capabilities/configure-apple-pay/"
          ]
        },
        {
          "text": "To learn more about setting up your Apple developer account and implementing Apple Pay in your apps, see `managing-payment-processing-certificates` and `https://developer.apple.com/documentation/passkit/setting-up-apple-pay`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/managing-payment-processing-certificates",
            "https://developer.apple.com/documentation/passkit/setting-up-apple-pay"
          ]
        },
        {
          "text": "> **Note**\n>\n> Apple Pay is not available for Enterprise teams.",
          "refs": []
        }
      ],
