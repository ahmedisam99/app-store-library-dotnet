      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `profiles` resource represents the provisioning profiles that allow you to install apps on your iOS devices or Mac. You can create and delete provisioning profiles, and download them to sign your code.",
          "refs": []
        },
        {
          "text": "Provisioning profiles include signing certificates, device identifiers, and a bundle ID.",
          "refs": []
        }
      ],
