  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `customerReviews` resource represents the ratings and reviews that customers write for your app that the App Store displays. Customers can provide reviews for your app in the App Store, or when your app requests a review. For more information about reviews, see `https://developer.apple.com/app-store/ratings-and-reviews/`.",
          "refs": [
            "https://developer.apple.com/app-store/ratings-and-reviews/"
          ]
        },
        {
          "text": "Use this API to read the customer reviews for your app as follows:",
          "refs": []
        },
        {
          "text": "To manage your responses to the customers reviews, use the endpoints in `customer-review-responses`. For example, call `GET-v1-customerReviews-_id_-response` using the resource ID of the customer review to read your response to that review.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/customer-review-responses",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-customerReviews-_id_-response"
          ]
        }
      ],
      "listItems": [
        {
          "text": "Call the `GET-v1-apps-_id_-customerReviews` endpoint to get all customer reviews for your app. Filter the reviews by territory and rating, and sort them by date or rating. You can also get a list of the reviews with or without published responses.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-apps-_id_-customerReviews"
          ]
        },
        {
          "text": "Call the `GET-v1-appStoreVersions-_id_-customerReviews` endpoint to get the customer reviews for a specific app version.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-appStoreVersions-_id_-customerReviews"
          ]
        },
        {
          "text": "Call the `GET-v1-customerReviews-_id_` endpoint using the resource ID of the review to read the details of a specific review.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-customerReviews-_id_"
          ]
        }
      ]
    }
  ],
