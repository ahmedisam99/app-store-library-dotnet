      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 3.4 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New Features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "You can now use the `analytics` reports API to download and analyze your app’s usage, and performance, and find opportunities for improvement. To learn more about interpreting the data using the glossary of report fields and definitions, see `analytics-reports`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/analytics",
            "doc://com.apple.documentation/documentation/analytics-reports"
          ]
        },
        {
          "text": "Added `FIRST_ANNUAL` report type to `GET-v1-salesReports`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v1-salesReports"
          ]
        }
      ]
    }
