  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `subscriptionPlanAvailabilities` resource lets you control which subscription plan type — monthly or up-front — is available for a subscription in specific territories.",
          "refs": []
        },
        {
          "text": "There are two possible values for the subscription plan type: `MONTHLY` and `UPFRONT`. To learn more, see `SubscriptionPlanType` and `https://developer.apple.com/help/app-store-connect/manage-subscriptions/set-availability-for-an-auto-renewable-subscription`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/SubscriptionPlanType",
            "https://developer.apple.com/help/app-store-connect/manage-subscriptions/set-availability-for-an-auto-renewable-subscription"
          ]
        },
        {
          "text": "Use it to:",
          "refs": []
        }
      ],
      "listItems": [
        {
          "text": "Create a plan availability configuration for a subscription.",
          "refs": []
        },
        {
          "text": "Read or modify the available territories for a plan availability.",
          "refs": []
        },
        {
          "text": "Update available territories for a subscription plan availability.",
          "refs": []
        }
      ]
    }
  ],
