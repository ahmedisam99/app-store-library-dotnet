  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 1.6 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The API adds `app-clips-and-app-clip-experiences`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-clips-and-app-clip-experiences"
          ]
        },
        {
          "text": "For TestFlight, a new attribute in `Attributes-data.dictionary` helps developers manage their iOS apps on Apple silicon Mac computers.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/BetaGroupUpdateRequest/Data-data.dictionary/Attributes-data.dictionary"
          ]
        },
        {
          "text": "The `BuildBundles-data.dictionary` and `BuildBundleFileSizes-data.dictionary` relationships provide developers more insight into their app binaries.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/Build/Relationships-data.dictionary/BuildBundles-data.dictionary",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/BuildBundle/Relationships-data.dictionary/BuildBundleFileSizes-data.dictionary"
          ]
        },
        {
          "text": "The `apps` resource adds the ability to configure a subscription status URL for production and sandbox environments in `Attributes-data.dictionary` and `Attributes-data.dictionary`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/apps",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/App/Attributes-data.dictionary",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/AppUpdateRequest/Data-data.dictionary/Attributes-data.dictionary"
          ]
        }
      ]
    }
  ],
