  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use the `sub()` function in the expression of a matchmaking rule to subtract two numbers.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Declaration",
      "paragraphs": [
        {
          "text": "```other\nnumber sub(number $minuend, number $subtrahend)\n```",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Parameters",
      "paragraphs": [
        {
          "text": "-`minuend`: The left side of the subtraction equation. -`subtrahend`: The right side of the subtraction equation.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Return value",
      "paragraphs": [
        {
          "text": "The result of subtracting `subtrahend` from `minuend`. If either parameter isn’t a number, `null`.",
          "refs": []
        }
      ],
      "listItems": []
    }
  ],
