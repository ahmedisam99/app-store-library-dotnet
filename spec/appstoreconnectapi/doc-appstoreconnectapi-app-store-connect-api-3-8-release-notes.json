  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 3.8 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New Features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `merchantids` resource is now available to automate tasks related to Apple Pay and Apple Wallet. Apple Pay certificates now have enum values on the `certificates` resource.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/merchantids"
          ]
        },
        {
          "text": "`PATCH-v1-certificates-_id_` is now available. Use this endpoint to modify the activation status of your Payment Processing certificate. To learn more, see `managing-payment-processing-certificates`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/PATCH-v1-certificates-_id_",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/managing-payment-processing-certificates"
          ]
        },
        {
          "text": "Create public links that accept testers with specific device and OS combinations using the `betaRecruitmentCriteria` resource. To learn more, see `beta-recruitment-criteria`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/beta-recruitment-criteria"
          ]
        },
        {
          "text": "Use the new `nominations` resource to share your new content, app enhancement, or app launch with Apple. To learn more see, `https://developer.apple.com/app-store/getting-featured/`.",
          "refs": [
            "https://developer.apple.com/app-store/getting-featured/"
          ]
        },
        {
          "text": "Three new content statuses, `TRADER_STATUS_NOT_PROVIDED`, `TRADER_STATUS_VERIFICATION_FAILED`, and `TRADER_STATUS_VERIFICATION_STATUS_MISSING` are available for `Attributes-data.dictionary`. To learn more, see `https://developer.apple.com/help/app-store-connect/manage-compliance-information/manage-european-union-digital-services-act-trader-requirements`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/TerritoryAvailability/Attributes-data.dictionary",
            "https://developer.apple.com/help/app-store-connect/manage-compliance-information/manage-european-union-digital-services-act-trader-requirements"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Improvements",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The field `iosBuildsAvailableForAppleVision` is now in the `beta-groups` resource.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/beta-groups"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Deprecations",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The attribute `brazilAgeRatings` for `Attributes-data.dictionary` is deprecated. Use `brazilAgeRatingV2` instead.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/AppInfo/Attributes-data.dictionary"
          ]
        }
      ]
    },
    {
      "level": 3,
      "heading": "Removals",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The `PromotedPurchaseImages` resources is now removed and replaced with `subscription-images` and `in-app-purchase-images`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/subscription-images",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/in-app-purchase-images"
          ]
        },
        {
          "text": "The enum `ELAPSED_TIME_MILLISECOND` is now removed from `GameCenterLeaderboardFormatter`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GameCenterLeaderboardFormatter"
          ]
        }
      ]
    }
  ],
