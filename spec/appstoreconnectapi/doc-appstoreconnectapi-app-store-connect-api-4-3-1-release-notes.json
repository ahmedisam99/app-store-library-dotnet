    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 4.3.1 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Improvements",
      "paragraphs": [],
      "listItems": [
        {
          "text": "You can now create and update localized metadata in 11 additional languages. To learn more, see `managing-metadata-in-your-app-by-using-locale-shortcodes`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/managing-metadata-in-your-app-by-using-locale-shortcodes"
          ]
        },
        {
          "text": "`BRAZIL_GAMBLING_NOT_VERIFIED` content status is available when calling `GET-v2-appAvailabilities-_id_-territoryAvailabilities`. This status indicates that your app is missing Real Money Gambling (RMG) verification, so it’s not available for sale in Brazil.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/GET-v2-appAvailabilities-_id_-territoryAvailabilities"
          ]
        }
      ]
    }
