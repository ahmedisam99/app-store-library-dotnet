      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "`appStoreVersionPhasedReleases` handles your process of releasing app updates to customers in stages. Use this resource to set up your process for an app update. This resource is not available for the first version of an app, only for subsequent releases.",
          "refs": []
        },
        {
          "text": "For more information, see `https://developer.apple.com/help/app-store-connect/update-your-app/release-a-version-update-in-phases`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/update-your-app/release-a-version-update-in-phases"
          ]
        }
      ],
