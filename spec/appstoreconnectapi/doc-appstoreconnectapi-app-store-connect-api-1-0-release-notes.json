  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "This REST API provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "Manage beta builds of your app, beta testers, and groups for TestFlight with resources in `prerelease-versions-and-beta-testers`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/prerelease-versions-and-beta-testers"
          ]
        },
        {
          "text": "Manage your users and their access with the `users` resources. Invite users to join your team with the `user-invitations` resource.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/users",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/user-invitations"
          ]
        },
        {
          "text": "Download sales and financial reports in `sales-and-finance`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/sales-and-finance"
          ]
        }
      ]
    }
  ],
