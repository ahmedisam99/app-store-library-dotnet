      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "App Store Connect API version 1.1 provides resources that enable you to automate actions you take in App Store Connect.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "New features",
      "paragraphs": [],
      "listItems": [
        {
          "text": "The API now supports provisioning, including managing bundle IDs with the `bundle-ids` and `bundle-id-capabilities` resources, managing certificates with the `certificates` resource, registering test devices with the `devices` resource, and managing provisioning profiles with `profiles`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/bundle-ids",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/bundle-id-capabilities",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/certificates",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/devices",
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/profiles"
          ]
        }
      ]
    }
