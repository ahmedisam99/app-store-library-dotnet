      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `appClipAdvancedExperiences` resource represents an advanced App Clip experience. You use it to access an advanced App Clip experience you already created, create a new advanced App Clip experience, or update an existing advanced App Clip experience. Additionally, you can use the resource’s `PATCH` operation to delete an unreleased advanced App Clip experience.",
          "refs": []
        }
