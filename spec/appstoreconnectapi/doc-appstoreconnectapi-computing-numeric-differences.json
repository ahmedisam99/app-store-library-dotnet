  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "Use the `diff()` function in the expression of a matchmaking rule to compute the greatest difference between two or more values. For example, `diff([ `4`, `3`, `2`, `1` ])` returns `3`, and  `diff([ `50`, `19`, `21`, `61` ]` returns `42`.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Declaration",
      "paragraphs": [
        {
          "text": "```other\nnumber diff(array[number] $values)\n```",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Parameters",
      "paragraphs": [
        {
          "text": "-`values`: An array that contains the numeric values to compare.",
          "refs": []
        }
      ],
      "listItems": []
    },
    {
      "level": 3,
      "heading": "Return value",
      "paragraphs": [
        {
          "text": "The absolute difference between the maximum and minimum items in the `values` array.",
          "refs": []
        }
      ],
      "listItems": []
    }
