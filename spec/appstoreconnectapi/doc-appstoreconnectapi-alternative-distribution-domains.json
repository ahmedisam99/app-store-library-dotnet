  "article": [
    {
      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "You use the endpoints and objects in this API collection to add your alternative distribution app’s base domain to App Store Connect. For more information on adding a domain for your alternative distribution app, see `POST-v1-alternativeDistributionDomains`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/POST-v1-alternativeDistributionDomains"
          ]
        },
        {
          "text": "All the individual pages for apps that your alternative marketplace app distributes need to be on this base domain and it also needs to house your sitemap to support marketplace search. For more information about your alternative marketplace’s sitemap, see `building-a-searchable-catalog-for-your-marketplace-app-for-inclusion-in-spotlight`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/building-a-searchable-catalog-for-your-marketplace-app-for-inclusion-in-spotlight"
          ]
        },
        {
          "text": "Your web distribution app needs to be served from this base domain.",
          "refs": []
        }
      ],
