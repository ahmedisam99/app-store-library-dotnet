      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `appStoreVersionReleaseRequests` resource handles requests to manually release a version of your app that’s in the Pending Developer Release state. For more information about app states, see `https://developer.apple.com/help/app-store-connect/reference/app-and-submission-statuses`.",
          "refs": [
            "https://developer.apple.com/help/app-store-connect/reference/app-and-submission-statuses"
          ]
        },
        {
          "text": "For more information about version releases, see `https://devcms.apple.com/help/app-store-connect/manage-your-apps-availability/select-a-version-release-option`.",
          "refs": [
            "https://devcms.apple.com/help/app-store-connect/manage-your-apps-availability/select-a-version-release-option"
          ]
        }
      ],
