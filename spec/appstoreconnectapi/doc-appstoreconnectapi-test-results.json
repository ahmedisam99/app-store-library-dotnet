      "heading": "Overview",
      "paragraphs": [
        {
          "text": "The `ciTestResult` resource represents the test results that Xcode Cloud makes available if you configure a workflow to include a test action. Use this resource to access:",
          "refs": []
        },
        {
          "text": "> **Note**\n>\n>  This resource supports JSON web tokens with a lifetime of up to six months. For more information, see `generating-tokens-for-api-requests#Determine-the-Appropriate-Token-Lifetime`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/generating-tokens-for-api-requests#Determine-the-Appropriate-Token-Lifetime"
          ]
        }
      ],
      "listItems": [
        {
          "text": "The name of the test class",
          "refs": []
        },
        {
          "text": "Test file information",
          "refs": []
        },
        {
          "text": "The name and operating system version of the simulated device that Xcode Cloud used to perform the tests",
          "refs": []
