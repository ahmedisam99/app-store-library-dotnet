      "level": 2,
      "heading": "Overview",
      "paragraphs": [
        {
          "text": "`appCategories` provides read-only information that includes the list of choices for an app’s App Store category, subcategory, and secondary category.",
          "refs": []
        },
        {
          "text": "To update your app’s categories, use the `app-infos` resource. For more information about categories, see `https://developer.apple.com/app-store/categories/`.",
          "refs": [
            "doc://com.apple.appstoreconnectapi/documentation/AppStoreConnectAPI/app-infos",
            "https://developer.apple.com/app-store/categories/"
          ]
        }
      ],
