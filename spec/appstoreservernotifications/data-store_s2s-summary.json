  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "The `summary` object appears in the `responseBodyV2DecodedPayload` when the `notificationType` is `RENEWAL_EXTENSION` and the `subtype` is `SUMMARY`. This notification occurs when the App Store completes your request to extend the subscription renewal date for eligible subscribers. For more information about this request, see `Extend-Subscription-Renewal-Dates-for-All-Active-Subscribers` in the `AppStoreServerAPI`.",
          "refs": [
            "doc://com.apple.appstoreservernotifications/documentation/AppStoreServerNotifications/responseBodyV2DecodedPayload",
            "doc://com.apple.appstoreservernotifications/documentation/AppStoreServerNotifications/notificationType",
            "doc://com.apple.appstoreservernotifications/documentation/AppStoreServerNotifications/subtype",
            "doc://com.apple.documentation/documentation/AppStoreServerAPI/Extend-Subscription-Renewal-Dates-for-All-Active-Subscribers",
