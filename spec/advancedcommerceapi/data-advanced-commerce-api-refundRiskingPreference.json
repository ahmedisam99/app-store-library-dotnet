  "abstract": {
    "text": "A Boolean value that indicates whether the App Store asks you for consumption data to help inform the refund decision.",
    "refs": []
  },
  "declaration": {
    "tokens": "boolean refundRiskingPreference",
    "baseType": "boolean",
    "isArray": false,
    "elementType": null
  },
  "constraints": [],
  "values": null,
  "properties": null,
