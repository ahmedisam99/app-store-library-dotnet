  "article": [
    {
      "level": 3,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "A dependent SKU is a product identifier that represents an item that depends on another SKU in the context of subscription price changes. Dependent SKUs cannot be chained or shared between multiple parent SKUs.",
          "refs": []
        },
        {
          "text": "The dependentSKU value is a string with a maximum length of 128 characters.",
          "refs": []
        }
