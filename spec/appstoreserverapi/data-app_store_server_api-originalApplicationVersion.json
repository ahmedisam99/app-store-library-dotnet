  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Use this value to determine which app version the customer first purchased or downloaded. This value remains constant and doesn’t change when the customer upgrades the app.",
          "refs": []
        },
        {
          "text": "The string value contains the original value of the `CFBundleShortVersionString` for apps running in macOS, and the original value of the `CFBundleVersion` for apps running on all other platforms.",
          "refs": [
            "doc://com.apple.documentation/documentation/BundleResources/Information-Property-List/CFBundleShortVersionString",
            "doc://com.apple.documentation/documentation/BundleResources/Information-Property-List/CFBundleVersion"
          ]
        },
        {
          "text": "In the sandbox testing environment, the `originalApplicationVersion` value is always 1.0.",
          "refs": []
        }
      ],
      "listItems": []
    }
  ],
