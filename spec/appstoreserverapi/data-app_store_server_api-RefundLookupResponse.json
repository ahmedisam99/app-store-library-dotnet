      "abstract": {
        "text": "A list of JWS transactions, or an empty array if the customer has received no refunds in your app. The transactions are sorted in ascending order by their `revocationDate`.",
        "refs": [
          "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/revocationDate"
        ]
