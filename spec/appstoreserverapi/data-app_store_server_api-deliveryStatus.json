  "properties": null,
  "endpoints": null,
  "parameters": null,
  "requestBody": null,
  "responses": null,
  "notes": [
    {
      "style": "note",
      "prose": {
        "text": "If the delivery status isn’t `DELIVERED`, set the `consumptionPercentage` to `0`; otherwise, the request fails with an error.",
        "refs": [
          "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/consumptionPercentage"
        ]
      }
    }
  ],
  "tables": [],
  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Use these delivery status values in the `ConsumptionRequest` request body.",
          "refs": [
            "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/ConsumptionRequest"
          ]
        },
        {
          "text": "> **Note**\n>\n> If the delivery status isn’t `DELIVERED`, set the `consumptionPercentage` to `0`; otherwise, the request fails with an error.",
          "refs": [
