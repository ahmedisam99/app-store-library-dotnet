    {
      "name": "UNDELIVERED_WRONG_ITEM",
      "abstract": {
        "text": "The app delivered the wrong item.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    },
    {
      "name": "UNDELIVERED_SERVER_OUTAGE",
      "abstract": {
        "text": "The app didn’t deliver the In-App Purchase due to a server outage.",
