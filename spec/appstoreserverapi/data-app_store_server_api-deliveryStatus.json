  "constraints": [],
  "values": [
    {
      "name": "DELIVERED",
      "abstract": {
        "text": "The app delivered the In-App Purchase and it’s working properly.",
        "refs": []
      },
      "deprecated": false,
      "introducedVersion": null
    },
    {
      "name": "UNDELIVERED_QUALITY_ISSUE",
      "abstract": {
        "text": "The app didn’t deliver the In-App Purchase due to a quality issue.",
