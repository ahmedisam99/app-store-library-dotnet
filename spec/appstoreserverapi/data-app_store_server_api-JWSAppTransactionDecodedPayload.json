            "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/Get-App-Transaction-Info",
            "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/JWSAppTransaction"
          ]
        },
        {
          "text": "You can also get app transaction information in your app from StoreKit, using `AppTransaction`.",
          "refs": [
            "doc://com.apple.documentation/documentation/StoreKit/AppTransaction"
          ]
        }
