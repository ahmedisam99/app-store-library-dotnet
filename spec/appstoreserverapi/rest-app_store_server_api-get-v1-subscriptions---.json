  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "This API returns the status for all of the customer’s subscriptions, organized by their subscription group identifier.",
          "refs": []
        },
        {
          "text": "Specify multiple values for the `status` query parameter to get a response that contains subscriptions with statuses that match any of the values. For example, the following request returns subscriptions that are active (`status` value of `1`) and subscriptions that are in the Billing Grace Period (`status` value of `4`):",
          "refs": [
            "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/Get-All-Subscription-Statuses/status"
          ]
        },
        {
          "text": "```javascript\nGET https://api.storekit.apple.com/inApps/v1/subscriptions/{anyTransactionId}?status=1&status=4\n```",
          "refs": []
        }
      ],
