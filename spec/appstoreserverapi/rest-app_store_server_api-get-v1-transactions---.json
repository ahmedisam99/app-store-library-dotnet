  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "Use this endpoint to get transaction information for any transaction identifier, including original transaction identifiers.  This endpoint supports all in-app purchase types, including consumable, non-consumable, non-renewing subscriptions, and auto-renewable subscriptions. It also supports transactions that your app marked as finished using `finish()` or `finishTransaction(_:)` in StoreKit.",
          "refs": [
            "doc://com.apple.documentation/documentation/StoreKit/Transaction/finish()",
            "doc://com.apple.documentation/documentation/StoreKit/SKPaymentQueue/finishTransaction(_:)"
          ]
        }
      ],
