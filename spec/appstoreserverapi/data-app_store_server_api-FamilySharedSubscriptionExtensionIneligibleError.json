  "article": [
    {
      "level": 2,
      "heading": "Discussion",
      "paragraphs": [
        {
          "text": "A request returns this error if you call the `Extend-a-Subscription-Renewal-Date` endpoint with an `originalTransactionId` that belongs to a subscription the user obtains through Family Sharing.",
          "refs": [
            "doc://com.apple.appstoreserverapi/documentation/AppStoreServerAPI/Extend-a-Subscription-Renewal-Date"
          ]
        },
        {
          "text": "When the endpoint extends an eligible purchased subscription that supports Family Sharing, it automatically extends the family members’ subscriptions as well. However, the endpoint doesn’t support requests to extend a family member’s subscription directly.",
          "refs": []
        }
      ],
      "listItems": []
    }
